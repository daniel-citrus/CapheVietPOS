# ---------------------------------------------------------------------------
# Cà phê Việt — environment
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# ---------------------------------------------------------------------------

# Which catalog data source the app talks to.
#   mock   — in-memory fixtures, no network, no token needed (default)
#   square — live Square Catalog via the Vite dev proxy (needs the token below)
VITE_DATA_SOURCE=mock

# ---------------------------------------------------------------------------
# Square
# ---------------------------------------------------------------------------
# Your Square access token. This is read ONLY by the Vite dev server
# (vite.config.ts) and injected into proxied requests server-side — it is
# never bundled into the browser and never VITE_-prefixed.
#
# Create one at https://developer.squareup.com/apps -> your app -> Credentials.
# Recommended scopes: ITEMS_READ, ITEMS_WRITE, MERCHANT_PROFILE_READ.
SQUARE_ACCESS_TOKEN=

# sandbox | production
SQUARE_ENVIRONMENT=sandbox

# Optional. Pin a single location; otherwise the first active location is used.
SQUARE_LOCATION_ID=

# Optional. Full override of the Square host used by `npm run export:catalog`
# (otherwise derived from SQUARE_ENVIRONMENT).
# SQUARE_API_BASE=https://connect.squareup.com

# ---------------------------------------------------------------------------
# Agent (chat) — optional
# ---------------------------------------------------------------------------
# Anthropic API key for the conversational agent. Read ONLY by the Vite dev
# server (vite.config.ts) and injected into `/api/anthropic/*` requests
# server-side — never bundled into the browser, never VITE_-prefixed. The
# client only ever learns whether it's set (via /api/anthropic-status), not
# its value. If empty, the chat falls back to a built-in offline command
# parser (limited but functional).
ANTHROPIC_API_KEY=

# Model id for the agent. Not a secret — fine to bundle.
VITE_AGENT_MODEL=claude-sonnet-5
