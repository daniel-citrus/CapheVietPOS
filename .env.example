# ---------------------------------------------------------------------------
# Cà phê Việt — environment
# Copy to `.env.local` (git-ignored). The **backend** reads this file
# (`npm run dev:api` runs `tsx --env-file=.env.local`). The browser bundle
# reads none of it — the frontend only ever calls `/api/*` and learns what it
# needs from `GET /api/meta`.
# ---------------------------------------------------------------------------

# Port the Fastify backend listens on; Vite proxies /api here in dev.
API_PORT=3001

# Which catalog the backend talks to:
#   mock   — in-memory fixtures, no token needed (default)
#   square — live Square Catalog
DATA_SOURCE=mock

# ---------------------------------------------------------------------------
# Square  (only used when DATA_SOURCE=square, and by `npm run export:catalog`)
# ---------------------------------------------------------------------------
# https://developer.squareup.com/apps -> your app -> Credentials.
# Recommended scopes: ITEMS_READ, ITEMS_WRITE, MERCHANT_PROFILE_READ.
SQUARE_ACCESS_TOKEN=

# sandbox | production  — picks the Square host
SQUARE_ENVIRONMENT=sandbox

# Optional. Pin a single location; otherwise the first active location is used.
SQUARE_LOCATION_ID=

# ---------------------------------------------------------------------------
# Agent (chat)
# ---------------------------------------------------------------------------
# Anthropic API key. If empty, the chat falls back to a small offline command
# parser (still runs server-side, still streams the same events). The browser
# never sees this value — only whether it's set.
ANTHROPIC_API_KEY=

# Model id for the agent.
AGENT_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Audit log
# ---------------------------------------------------------------------------
# SQLite file the append-only audit log is written to (created on first run).
SQLITE_PATH=server/data/audit.sqlite
